<?xml version="1.0"?>
<robot name="rail_cart" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="config" default="$(find rail_align_demo)/config/demo.yaml"/>
  <xacro:arg name="chase_camera" default="false"/>
  <xacro:property name="cfg" value="${xacro.load_yaml('$(arg config)')['rail_align']}"/>
  <xacro:property name="cam" value="${cfg['camera']}"/>
  <xacro:property name="wheel_radius" value="${cfg['vehicle']['wheel_radius_m']}"/>
  <xacro:property name="wheel_separation" value="${cfg['vehicle']['wheel_separation_m']}"/>
  <xacro:property name="wheel_width" value="${cfg['vehicle']['wheel_width_m']}"/>
  <xacro:property name="body_length" value="${cfg['vehicle']['body_length_m']}"/>
  <xacro:property name="body_width" value="${cfg['vehicle']['body_width_m']}"/>
  <xacro:property name="body_height" value="${cfg['vehicle']['body_height_m']}"/>
  <xacro:property name="body_center_z" value="${body_height/2 - wheel_radius/2}"/>
  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_offset" value="${body_length/2 - 0.08}"/>

  <xacro:macro name="wheel" params="name y">
    <link name="${name}_wheel">
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.0053" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.0053"/>
      </inertial>
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </visual>
      <!-- A sphere gives one stable contact point; ODE's cylinder line contact yaws the cart. -->
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${name}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster">
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.00018" ixy="0" ixz="0" iyy="0.00018" iyz="0" izz="0.00018"/>
      </inertial>
      <visual><geometry><sphere radius="${caster_radius}"/></geometry></visual>
      <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster"/>
      <origin xyz="${x} 0 ${caster_radius - wheel_radius}"/>
    </joint>
    <gazebo reference="${name}_caster">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <!-- base_link is the axle center, the vehicle reference point used for all errors. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${body_center_z}"/>
      <mass value="20.0"/>
      <inertia ixx="${20.0/12*(body_width**2 + body_height**2)}" ixy="0" ixz="0"
               iyy="${20.0/12*(body_length**2 + body_height**2)}" iyz="0"
               izz="${20.0/12*(body_length**2 + body_width**2)}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${body_center_z}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_center_z}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
  </link>
  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>

  <xacro:wheel name="left" y="${wheel_separation/2}"/>
  <xacro:wheel name="right" y="${-wheel_separation/2}"/>
  <xacro:caster name="front" x="${caster_offset}"/>
  <xacro:caster name="rear" x="${-caster_offset}"/>

  <link name="camera_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <!-- Kept behind the lens so the housing never appears in the image. -->
      <origin xyz="-0.02 0 0"/>
      <geometry><box size="0.03 0.05 0.03"/></geometry>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${cam['forward_m']} 0 ${cam['height_m'] - wheel_radius}"
            rpy="0 ${-radians(cam['pitch_up_deg'])} 0"/>
  </joint>
  <gazebo reference="camera_link">
    <material>Gazebo/Red</material>
    <sensor type="camera" name="rail_cam">
      <always_on>true</always_on>
      <update_rate>${cam['rate_hz']}</update_rate>
      <camera name="rail_cam">
        <horizontal_fov>${radians(cam['hfov_deg'])}</horizontal_fov>
        <image>
          <width>${cam['width_px']}</width>
          <height>${cam['height_px']}</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.02</near><far>20.0</far></clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${cam['noise_stddev']}</stddev>
        </noise>
      </camera>
      <plugin name="rail_cam_controller" filename="libgazebo_ros_camera.so">
        <robotNamespace>/</robotNamespace>
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>rail_cam</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>rail_cam_optical</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Only for the demo video: follows the cart to show the wheels outside the rails. -->
  <xacro:if value="$(arg chase_camera)">
    <link name="chase_camera_link">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>
    <joint name="chase_camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="chase_camera_link"/>
      <origin xyz="-1.5 0 1.1" rpy="0 0.5 0"/>
    </joint>
    <gazebo reference="chase_camera_link">
      <sensor type="camera" name="chase_cam">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <camera name="chase_cam">
          <horizontal_fov>1.1</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>30.0</far></clip>
        </camera>
        <plugin name="chase_cam_controller" filename="libgazebo_ros_camera.so">
          <robotNamespace>/</robotNamespace>
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <cameraName>chase_cam</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>chase_cam</frameName>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <robotNamespace>/</robotNamespace>
      <rosDebugLevel>na</rosDebugLevel>
      <updateRate>50</updateRate>
      <leftJoint>left_wheel_joint</leftJoint>
      <rightJoint>right_wheel_joint</rightJoint>
      <wheelSeparation>${wheel_separation}</wheelSeparation>
      <wheelDiameter>${2*wheel_radius}</wheelDiameter>
      <wheelTorque>6.0</wheelTorque>
      <!-- 0 disables the plugin's ramp, whose leftover per-wheel state yaws the cart when it stops. -->
      <wheelAcceleration>0</wheelAcceleration>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <!-- Wheel encoders, not the simulator's pose: /odom feeds the rail drive. -->
      <odometrySource>encoder</odometrySource>
      <robotBaseFrame>base_link</robotBaseFrame>
      <publishWheelTF>false</publishWheelTF>
      <publishWheelJointState>false</publishWheelJointState>
      <!-- Must stay on: the plugin only creates its /odom publisher when this is true. -->
      <publishTf>true</publishTf>
      <publishOdomTF>false</publishOdomTF>
      <legacyMode>false</legacyMode>
    </plugin>
  </gazebo>
</robot>
